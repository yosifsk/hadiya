{
  "name": "hadba-web3",
  "version": "1.0.0",
  "private": true,
  "description": "منصة تبرّع بالعملات الرقمية — ٩٪ رسوم منصة، ٩١٪ تصل مباشرة لمحفظة الجهة المستفيدة",
  "main": "src/server.js",
  "scripts": {
