<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main">
  <div class="container-narrow" style="padding:34px 0 60px">
    <h1 data-i18n="forgot_title">نسيت كلمة المرور؟</h1>
    <p class="muted" data-i18n="forgot_lead">
      اكتب اسم المستخدم وسنرسل لك رابطًا واحدًا لاستعادة كلمة المرور.
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (sent) { %>
      <div class="alert alert-ok" data-i18n="forgot_sent">
        إن كان الحساب موجودًا، فقد أرسلنا إليه رابط استعادة صالحًا لمدة ٣٠ دقيقة.
        تحقّق من بريدك، وإن لم تجد الرابط اطلب واحدًا جديدًا.
      </div>
      <% if (devLink) { %>
        <div class="alert alert-info" style="margin-top:12px">
          <div class="small"><strong>وضع التطوير:</strong> لا يوجد خادم بريد مهيّأ، فالرابط مباشر:</div>
          <a class="mono small" href="<%= devLink %>" style="word-break: break-all;"><%= devLink %></a>
        </div>
      <% } %>
      <div class="row-flex" style="margin-top:16px;gap:8px">
        <a class="btn btn-outline btn-sm" href="/login" data-i18n="back_to_login">رجوع لتسجيل الدخول</a>
        <a class="btn btn-ghost btn-sm" href="/forgot-password" data-i18n="forgot_again">طلب رابط جديد</a>
      </div>
    <% } else { %>
      <div class="panel" style="margin-top:18px">
        <form method="post" action="/forgot-password">
          <div class="field">
            <label data-i18n="username">اسم المستخدم</label>
            <input type="text" name="username" required autocomplete="username" placeholder="ahmad_2026">
            <div class="hint" data-i18n="forgot_hint">اكتب اسم المستخدم كما سجّلت به.</div>
          </div>
          <button class="btn btn-primary btn-lg btn-block" type="submit" data-i18n="forgot_submit">إرسال رابط الاستعادة</button>
        </form>
      </div>
      <div class="alert alert-info" style="margin-top:18px" data-i18n="forgot_wallet_note">
        إن كنت تدخل بمحفظة فقط، لا تحتاج كلمة مرور — <a href="/sign-in">ادخل بتوقيع المحفظة</a>.
      </div>
    <% } %>
  </div>
</main>
<%- include('partials/footer') %>
