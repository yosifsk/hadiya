<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main">
  <div class="container-narrow" style="padding:34px 0 60px">
    <h1 data-i18n="reset_title">تعيين كلمة مرور جديدة</h1>
    <p class="muted" data-i18n="reset_lead">
      كلمة المرور الجديدة تُخزَّن بـ Argon2id، وتُنهى كل جلساتك القديمة.
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="panel" style="margin-top:18px">
      <form method="post" action="/reset-password">
        <input type="hidden" name="token" value="<%= token %>">
        <div class="field">
          <label data-i18n="password">كلمة المرور الجديدة</label>
          <input type="password" name="password" required minlength="10" autocomplete="new-password">
          <div class="hint" data-i18n="password_hint">١٠ خانات على الأقل. تُخزَّن بـ Argon2id — لا نحفظ كلمة المرور نفسها أبدًا.</div>
        </div>
        <div class="field">
          <label data-i18n="password_confirm">تأكيد كلمة المرور</label>
          <input type="password" name="password2" required minlength="10" autocomplete="new-password">
        </div>
        <button class="btn btn-primary btn-lg btn-block" type="submit" data-i18n="save_new_password">حفظ كلمة المرور</button>
      </form>
    </div>

    <div class="alert alert-info" style="margin-top:18px" data-i18n="reset_note">
      بعد التغيير ستُسجَّل خروجك من كل الأجهزة — سجّل الدخول من جديد.
    </div>
  </div>
</main>
<%- include('partials/footer') %>
